# Copy this file to .env and fill in your real values. Never commit .env.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Set to "postgres" once you've installed PostgreSQL locally; leave as
# "sqlite" to keep using the zero-setup SQLite database for now.
DB_ENGINE=sqlite
DB_NAME=hardware_pos
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# M-Pesa Daraja (sandbox credentials from developer.safaricom.co.ke)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_EXPRESS_SHORTCODE=174379
MPESA_PASSKEY=
# Update this every time you restart ngrok (the URL changes each run
# unless you have a paid ngrok plan with a static domain).
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok-free.app/payments/mpesa/callback/
